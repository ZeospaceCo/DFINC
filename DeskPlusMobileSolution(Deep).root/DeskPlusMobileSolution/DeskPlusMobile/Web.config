		<add name="SQLConnAlarm" connectionString="Data Source=zeospace-20;Initial Catalog=SiteDFINCAlarm;Persist Security Info=True;User ID=deskpluseip;Password=deskplus" providerName="System.Data.SqlClient" />
		<add name="SQLConnEtc" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc1;Persist Security Info=True;User ID=deskpluseip;Password=deskplus" providerName="System.Data.SqlClient" />
		<add name="SQLConnEDMS" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEDM;Persist Security Info=True;User ID=deskpluseip;Password=deskplus" providerName="System.Data.SqlClient" />
		<add name="SQLConnMail" connectionString="Data Source=180.150.228.203;Initial Catalog=zmail_db_6;Persist Security Info=True;User ID=deskpluseip;Password=Zeo@!)*3070" providerName="System.Data.SqlClient" />
		<add name="SQLConnMessenger" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusMsn;Persist Security Info=True;User ID=deskpluseip;Password=deskplus" providerName="System.Data.SqlClient" />
		<add name="SQLConnAccountStatistics" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusStatistics33;Persist Security Info=True;User ID=deskpluseip;Password=deskplus" providerName="System.Data.SqlClient" />
		<add name="SQLEtc1" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc1;Persist Security Info=True;User ID=deskpluseip;Password=deskplus;MultipleActiveResultSets=False;Packet Size=4096;Application Name=&quot;Microsoft SQL Server Management Studio&quot;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc2" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc2;Persist Security Info=True;User ID=deskpluseip;Password=deskplus;MultipleActiveResultSets=False;Packet Size=4096;Application Name=&quot;Microsoft SQL Server Management Studio&quot;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc3" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc3;Persist Security Info=True;User ID=deskpluseip;Password=deskplus;MultipleActiveResultSets=False;Packet Size=4096;Application Name=&quot;Microsoft SQL Server Management Studio&quot;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc4" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc4;Persist Security Info=True;User ID=deskpluseip;Password=deskplus;MultipleActiveResultSets=False;Packet Size=4096;Application Name=&quot;Microsoft SQL Server Management Studio&quot;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc5" connectionString="Data Source=zeospace-20;Initial Catalog=DeskPlusEtc5;Persist Security Info=True;User ID=deskpluseip;Password=deskplus;MultipleActiveResultSets=False;Packet Size=4096;Application Name=&quot;Microsoft SQL Server Management Studio&quot;" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings file="WebAppSettings.config">
		<add key="SolutionTitle" value="smartplus" />
		<add key="UseXmlCache" value="false" />
		<add key="SiteName" value="SiteBase" />
		<add key="ComponentArt.Web.UI.ClientScriptLocation" value="~/Html/Js/ComponentArt/componentart_webui_client" />
	</appSettings>

	<system.web>
		<compilation debug="true" defaultLanguage="c#" targetFramework="4.8" />

		<httpHandlers>
			<add verb="*" path="/DeskPlusMobile/Common/Upload/UploadAttach.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadAttachHandler, Zeospace.DeskPlusMobile.Web" />
      <add verb="*" path="/DeskPlusMobile/Common/Upload/UploadMail.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadMailHandler, Zeospace.DeskPlusMobile.Web" /> 
			<add verb="*" path="/DeskPlusMobile/Common/Upload/UploadCommon.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadHandler, Zeospace.DeskPlusMobile.Web" />
			<add path="*.aspx" verb="*" type="ComponentArt.Web.UI.CallbackHandler,ComponentArt.Web.UI" />
			<add path="*.ascx" verb="*" type="ComponentArt.Web.UI.CallbackHandler,ComponentArt.Web.UI" />
		</httpHandlers>

		<pages buffer="true" enableViewState="false" enableSessionState="true" enableEventValidation="false" validateRequest="false" controlRenderingCompatibilityVersion="4.0">
			<controls>
				<!--add tagPrefix="zeoTree" src="/DeskPlusEIP/Account/Common/UserDeptTreeScript.ascx" tagName="UCUserDeptTreeScript" /-->
			</controls>
		</pages>

		<identity impersonate="true" userName="deskpluseip" password="Zeo@!)*3070" />

		<!--  인증 인증쿠키 만료시간 : 3시간 -->
		<authentication mode="Forms">
			<forms name="DeskPlusMobileAuth" path="/" loginUrl="/DeskPlusMobile/Portal/LogOut.aspx" cookieless="UseCookies" protection="All" timeout="2880">
			</forms>
		</authentication>

		<!--  사용자 지정 오류 메시지 -->
		<customErrors mode="Off" defaultRedirect="/DeskPlusEIP/Html/ErrorMessage/ErrorDefault.htm">
			<error statusCode="404" redirect="/DeskPlusEIP/Html/ErrorMessage/Error404.htm" />
			<error statusCode="405" redirect="/DeskPlusEIP/Html/ErrorMessage/Error405.htm" />
			<error statusCode="500" redirect="/DeskPlusEIP/Html/ErrorMessage/Error500.htm" />
		</customErrors>



		<!--  보안 권한 everyone 차단 -->
		<authorization>
			<deny users="?" />
		</authorization>

		<httpRuntime targetFramework="4.8" executionTimeout="270000" maxRequestLength="1048576" requestValidationMode="2.0" useFullyQualifiedRedirectUrl="false" />

		<!--  응용 프로그램 수준 추적 로깅 -->
		<trace enabled="false" requestLimit="10" pageOutput="false" traceMode="SortByTime" localOnly="true" />

		<!--  세션 상태 설정 -->
		<sessionState mode="InProc" cookieless="false" timeout="540" />

		<!--  전역화 설정 -->
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />

		<!--  webservice 설정 -->
		<webServices>
			<protocols>
				<add name="HttpPost" />
				<add name="HttpGet" />
			</protocols>
		</webServices>

	</system.web>

