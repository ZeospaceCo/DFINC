<?xml version='1.0' encoding='utf-8'?>
<configuration>
	<connectionStrings>
		<remove name="LocalSqlServer" />
		<add name="SQLConnMaster" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnSolution" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnAlarm" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnEtc" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnEDMS" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnMail" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnMessenger" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLConnAccountStatistics" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc1" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc2" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc3" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc4" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
		<add name="SQLEtc5" connectionString="Data Source=YOUR_DB_SERVER;Initial Catalog=YOUR_DB_NAME;User ID=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings file="WebAppSettings.config">
		<add key="SolutionTitle" value="smartplus" />
		<add key="UseXmlCache" value="false" />
		<add key="SiteName" value="SiteBase" />
		<add key="ComponentArt.Web.UI.ClientScriptLocation" value="~/Html/Js/ComponentArt/componentart_webui_client" />
	</appSettings>

	<system.web>
		<compilation debug="true" defaultLanguage="c#" targetFramework="4.8" />

		<httpHandlers>
			<add verb="*" path="/DeskPlusMobile/Common/Upload/UploadAttach.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadAttachHandler, Zeospace.DeskPlusMobile.Web" />
      <add verb="*" path="/DeskPlusMobile/Common/Upload/UploadMail.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadMailHandler, Zeospace.DeskPlusMobile.Web" /> 
			<add verb="*" path="/DeskPlusMobile/Common/Upload/UploadCommon.ashx" type="Zeospace.DeskPlusMobile.Web.Helper.UploadHandler, Zeospace.DeskPlusMobile.Web" />
			<add path="*.aspx" verb="*" type="ComponentArt.Web.UI.CallbackHandler,ComponentArt.Web.UI" />
			<add path="*.ascx" verb="*" type="ComponentArt.Web.UI.CallbackHandler,ComponentArt.Web.UI" />
		</httpHandlers>

		<pages buffer="true" enableViewState="false" enableSessionState="true" enableEventValidation="false" validateRequest="false" controlRenderingCompatibilityVersion="4.0">
			<controls>
				
			</controls>
		</pages>

		<identity impersonate="true" userName="YOUR_USERNAME" password="YOUR_PASSWORD" />

		
		<authentication mode="Forms">
			<forms name="DeskPlusMobileAuth" path="/" loginUrl="/DeskPlusMobile/Portal/LogOut.aspx" cookieless="UseCookies" protection="All" timeout="2880">
			</forms>
		</authentication>

		
		<customErrors mode="Off" defaultRedirect="/DeskPlusEIP/Html/ErrorMessage/ErrorDefault.htm">
			<error statusCode="404" redirect="/DeskPlusEIP/Html/ErrorMessage/Error404.htm" />
			<error statusCode="405" redirect="/DeskPlusEIP/Html/ErrorMessage/Error405.htm" />
			<error statusCode="500" redirect="/DeskPlusEIP/Html/ErrorMessage/Error500.htm" />
		</customErrors>



		
		<authorization>
			<deny users="?" />
		</authorization>

		<httpRuntime targetFramework="4.8" executionTimeout="270000" maxRequestLength="1048576" requestValidationMode="2.0" useFullyQualifiedRedirectUrl="false" />

		
		<trace enabled="false" requestLimit="10" pageOutput="false" traceMode="SortByTime" localOnly="true" />

		
		<sessionState mode="InProc" cookieless="false" timeout="540" />

		
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />

		
		<webServices>
			<protocols>
				<add name="HttpPost" />
				<add name="HttpGet" />
			</protocols>
		</webServices>

	</system.web>

	<location path="Portal/Default.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

