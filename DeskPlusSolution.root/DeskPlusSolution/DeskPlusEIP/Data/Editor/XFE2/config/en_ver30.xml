<?xml version="1.0"?>

<xfeEditor>

  <menubar visible="true">

    <!-- 파일 메뉴 설정. -->
    <File visible="false" title="File">
      <NewFile visible="true" title="New"/>
      <OpenFile visible="true" title="Open file"/>
      <split/>
      <Layout visible="true" title="Layout"/>
      <split/>
      <SaveFile visible="true" title="Save"/>
      <AutoSave visible="true" title="Load autosave"/>
      <split/>
      <Print visible="true" title="Print"/>
      <Pagebreak visible="true" title="Page break"/>
    </File>

    <!-- 편집 메뉴 설정. -->
    <Edit visible="true" title="Edit">
      <Undo visible="true" title="Undo"/>
      <Redo visible="true" title="Redo"/>
      <split/>
      <Cut visible="true" title="Cut"/>
      <Copy visible="true" title="Copy"/>
      <Paste visible="true" title="Paste"/>
      <split/>
      <SelectAll visible="true" title="Select all"/>
      <split/>
      <Replace visible="true" title="Find/Replace"/>
    </Edit>

    <!-- 삽입 메뉴 설정. -->
    <Insert visible="true" title="Insert">
      <Background visible="true" title="Document Background"/>
      <InsertImage visible="true" title="Image"/>
      <Object visible="true" title="Entity">
        <InsertMediaLink visible="true" title="Media link"/>
        <InsertFlash visible="true" title="Flash"/>
      </Object>
      <split/>
      <InsertHyperlink visible="true" title="Hyperlink"/>
      <Bookmark visible="true" title="Bookmark"/>
      <HorizontalRule visible="true" title="Horizontal line"/>
      <InsertSymbol visible="true" title="Symbol"/>
    </Insert>

    <!-- 보기 메뉴 설정. -->
    <View visible="true" title="View">
      <ZeroBorder visible="true" title="Zero border"/>
      <split/>
      <Fullscreen visible="true" title="Fullscreen"/>
      <split/>
      <Design visible="true" title="Design"/>
      <Html visible="true" title="HTML"/>
      <Preview visible="true" title="Preview"/>
      <Text visible="true" title="TEXT"/>
    </View>

    <!-- 표 메뉴 설정. -->
    <Table visible="true" title="Table">
      <InsertTable visible="true" title="New table"/>
      <DeleteTable visible="true" title="Delete table"/>
      <split/>
      <InsertRowColumn visible="true" title="Insert row/column">
        <InsertRowAbove visible="true" title="Insert row above"/>
        <InsertRowBelow visible="true" title="Insert row below"/>
        <InsertColumnLeft visible="true" title="Insert column left"/>
        <InsertColumnRight visible="true" title="Insert column right"/>
      </InsertRowColumn>
      <DeleteRowColumn visible="true" title="Delete row/column">
        <DeleteRow visible="true" title="Delete row"/>
        <DeleteColumn visible="true" title="Delete column"/>
      </DeleteRowColumn>
      <split/>
      <MergeCell visible="true" title="Merge cell"/>
      <SplitCell visible="true" title="Split cell"/>
      <split/>
      <SelectCell visible="true" title="Select cell"/>
      <ResizeCell visible="true" title="Cell size">
        <ResizeWidth visible="true" title="Same width"/>
        <ResizeHeight visible="true" title="Same height"/>
      </ResizeCell>
      <VerticalAlign visible="true" title="Vertical Align">
        <VerticalBase visible="true" title="Baseline"/>
        <AlignTop visible="true" title="Top"/>
        <AlignMiddle visible="true" title="Middle"/>
        <AlignBottom visible="true" title="Bottom"/>
      </VerticalAlign>
      <split/>
      <TableProperty visible="true" title="Table property"/>
      <CellProperty visible="true" title="Cell property"/>
    </Table>

    <!-- 서식 메뉴 설정. -->
    <Style visible="true" title="Form">
      <Bold visible="true" title="Bold"/>
      <Italic visible="true" title="Italic"/>
      <Underline visible="true" title="Underline"/>
      <Strikethrough visible="true" title="Strike through"/>
      <Superscript visible="true" title="Superscript"/>
      <Subscript visible="true" title="Subscript"/>
      <split/>
      <RemoveFormatting visible="true" title="Remove format"/>
      <split/>
      <Bullets visible="true" title="Number Bullet"/>
      <Numbering visible="true" title="Bullet"/>
      <split/>
      <IncreaseIndent visible="true" title="Indent"/>
      <DecreaseIndent visible="true" title="Outdent"/>
      <split/>
      <Align visible="true" title="Align">
        <AlignLeft visible="true" title="Align left"/>
        <AlignCenter visible="true" title="Align center"/>
        <AlignRight visible="true" title="Align right"/>
        <Justify visible="true" title="Align full"/>
      </Align>
    </Style>

    <!-- 도구 메뉴 설정. -->
    <Tool visible="true" title="Tool">
      <PageProperty visible="true" title="Setting"/>
    </Tool>

    <!-- 도움말 메뉴 설정. -->
    <Help visible="true" title="Help">
      <UserGuide visible="true" title="User Manual"/>
      <About visible="true" title="About X-Free"/>
    </Help>
  </menubar>


