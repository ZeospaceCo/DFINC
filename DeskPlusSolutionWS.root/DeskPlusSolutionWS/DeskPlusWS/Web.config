<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <connectionStrings configSource="WebConnectionString.config"></connectionStrings>
  <appSettings file="webAppSettings.config"></appSettings>

  <system.web>
    <compilation debug="true" defaultLanguage="c#" targetFramework="4.8" />

    <httpHandlers>      
    </httpHandlers>

    <identity impersonate="true" userName="deskpluseip" password="desk+e1p_20220706" />

    <!--  인증 인증쿠키 만료시간 : 3시간 -->
    <authentication mode="Forms">
      <forms name="DeskPlusEIPAuth" path="/" loginUrl="/DeskPlusEIP/Site/Auth/Default.aspx" cookieless="UseCookies" protection="All" timeout="480">
      </forms>
    </authentication>

    <!--  사용자 지정 오류 메시지 -->
    <customErrors mode="Off" defaultRedirect="/DeskPlusEIP/Html/ErrorMessage/ErrorDefault.htm">
      <error statusCode="404" redirect="/DeskPlusEIP/Html/ErrorMessage/Error404.htm" />
      <error statusCode="405" redirect="/DeskPlusEIP/Html/ErrorMessage/Error405.htm" />
      <error statusCode="500" redirect="/DeskPlusEIP/Html/ErrorMessage/Error500.htm" />
    </customErrors>



    <!--  보안 권한 everyone 차단 -->
    <authorization>
      <deny users="?" />
    </authorization>

    <!-- KB 단위(1gb = [1,048,576kb / 1024 = 1,024 MB = 1GB]) -->
    <httpRuntime targetFramework="4.8" executionTimeout="270000" maxRequestLength="1048576" requestValidationMode="2.0" useFullyQualifiedRedirectUrl="false" maxUrlLength="2048" maxQueryStringLength="2048" />

    <!--  응용 프로그램 수준 추적 로깅 -->
    <trace enabled="false" requestLimit="10" pageOutput="false" traceMode="SortByTime" localOnly="true" />

    <!--  세션 상태 설정 -->
    <sessionState mode="InProc" cookieless="false" timeout="540" />

    <!--  전역화 설정 -->
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />

    <!--  webservice 설정 -->
    <webServices>
      <protocols>
        <add name="HttpPost" />
        <add name="HttpGet" />
      </protocols>
    </webServices>

  </system.web>

  <location path="SetCodeInfo.asmx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="SetDeptInfo.asmx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="SetUserInfo.asmx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="ChangePassword.asmx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 컨텐츠 용량 : Bytes 단위(1gb : [1,073,741,824(Bytes)/1024] = [1,048,576 kb/1024] = [1,024 MB/1024] = 1GB)  -->
        <requestLimits maxAllowedContentLength="1073741824" maxUrl="4096" maxQueryString="2048" />
      </requestFiltering>
    </security>

    <defaultDocument>
      <files>
        <clear />
        <add value="default.aspx" />
        <add value="Default.htm" />
        <add value="Default.asp" />
        <add value="index.htm" />
        <add value="index.html" />
        <add value="iisstart.htm" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <clear/>
        <add name="X-UA-Compatible" value="IE=edge"/>
      </customHeaders>

    </httpProtocol>
  </system.webServer>

  <system.web.extensions>
    <scripting>
      <webServices>
        <jsonSerialization maxJsonLength="5000000" />
      </webServices>
    </scripting>
  </system.web.extensions>

</configuration>
